# Preencha no ambiente da Stack do Portainer; nunca inclua os valores no Git.
CORTEX_PUBLIC_URL=https://desk.cortexalter.tech
CORTEX_IMAGE=ghcr.io/lucass352/cortex:latest
CORTEX_ADMIN_USERNAME=admin
CORTEX_ADMIN_PASSWORD_HASH='scrypt$...'
CORTEX_SESSION_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
POSTGRES_PASSWORD=substitua-por-uma-senha-forte
MOVIDESK_TOKEN=substitua-pelo-token-da-empresa
MOVIDESK_WEBHOOK_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
MASTER_CONFIG_WEBHOOK_SECRET=substitua-por-outra-chave-aleatoria-de-pelo-menos-32-caracteres
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Piloto automático: disabled | dry_run | internal_note
CORTEX_AUTONOTE_MODE=disabled
MOVIDESK_BOT_PERSON_ID=
MOVIDESK_TICKET_UI_BASE=https://helpdesk.alternativasistemas.com.br/Ticket/Edit
CORTEX_PILOT_ORGANIZATION_IDS=
CORTEX_PILOT_TICKET_IDS=
CORTEX_PILOT_REQUESTER_EMAILS=
CORTEX_MOVIDESK_INTERVAL_SECONDS=7
CORTEX_RUNTIME_PILOT_CONTROL=true
