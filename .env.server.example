# Arquivo exclusivo do servidor. Copie para .env.server (ignorado pelo Git).
# docker compose --env-file .env.server up -d
# Use aspas simples nos valores para preservar caracteres como $ no hash scrypt.
CORTEX_PUBLIC_URL='http://179.236.68.24'
CORTEX_IMAGE='ghcr.io/lucass352/cortex:latest'
CORTEX_ADMIN_USERNAME='admin'
CORTEX_ADMIN_PASSWORD_HASH=''
CORTEX_SESSION_SECRET=''
POSTGRES_PASSWORD=''
MOVIDESK_TOKEN=''
MOVIDESK_WEBHOOK_SECRET=''
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-2.5-flash'
# Comece validando a nota na fila local; habilite internal_note após preencher o piloto.
CORTEX_AUTONOTE_MODE='dry_run'
MOVIDESK_BOT_PERSON_ID=''
MOVIDESK_TICKET_UI_BASE='https://helpdesk.alternativasistemas.com.br/Ticket/Edit'
# Compatibilidade para execução sem o painel; com controle dinâmico ativo, a seleção da tela prevalece.
CORTEX_PILOT_ORGANIZATION_IDS=''
CORTEX_PILOT_TICKET_IDS=''
# Intervalo mínimo deste worker (a quota da conta também é usada por outras integrações).
CORTEX_MOVIDESK_INTERVAL_SECONDS='7'
# Mantém a autorização dinâmica da tela como segunda trava obrigatória.
CORTEX_RUNTIME_PILOT_CONTROL='true'
